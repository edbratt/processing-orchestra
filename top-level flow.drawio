        <mxCell id="qV2FTbf2aPv-zclqZoTo-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="One Processing sketch processes data from every active session on each `draw()` cycle." vertex="1">
